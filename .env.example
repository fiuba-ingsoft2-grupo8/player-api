# FastAPI.
APP_ENV=development
ALLOWED_ORIGINS=*

# Supabase.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<tu_service_role_key>

# Buckets / Expiration of signed URLs (in seconds).
AUDIO_BUCKET=audio
IMAGES_BUCKET=images
SIGNED_URL_TTL=3600
PLAYER_BUCKET=tracks
JWT_SECRET="secret"
