# FastAPI
APP_ENV=development
APP_PORT=8004
ALLOWED_ORIGINS=*

# Supabase
SUPABASE_URL=https://<tu-proyecto>.supabase.co
# Usa la Service Role Key SOLO en el backend (nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=<tu_service_role_key>

# Buckets / expiración de URLs firmadas (en segundos)
AUDIO_BUCKET=audio
IMAGES_BUCKET=images
SIGNED_URL_TTL=3600
